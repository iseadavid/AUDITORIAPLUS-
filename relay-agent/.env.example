# Supabase Cloud Project Configuration
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"

# Supabase Service Role Key (Required to read/write Relay_Queue and bypass RLS)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# On-Premise MaraPlus Physical API Address (LAN)
MARAPLUS_BASE_URL="http://192.168.15.225:3002"

# Request timeout in milliseconds when calling MaraPlus physical API
MARAPLUS_TIMEOUT_MS=7000

# Identifier for this on-premise node/agent container
AGENT_INSTANCE_ID="maraplus-relay-server-01"

# Enable verbose debug logs (true / false)
DEBUG=false
